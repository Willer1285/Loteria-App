# Server Configuration
PORT=5000
NODE_ENV=development

# ==========================================
# Database Configuration
# ==========================================

# Opción 1: MongoDB Local
MONGODB_URI=mongodb://localhost:27017/loteria-app

# Opción 2: MongoDB Atlas (Cloud) - Recomendado para producción
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/loteria-app?retryWrites=true&w=majority
#
# Pasos para obtener tu URI de MongoDB Atlas:
# 1. Ve a https://cloud.mongodb.com
# 2. Crea un cluster gratuito
# 3. Crea un usuario de base de datos (Database Access)
# 4. Whitelist tu IP (Network Access) - Usa 0.0.0.0/0 para permitir todas
# 5. Click en "Connect" -> "Connect your application"
# 6. Copia la URI y reemplaza <password> con tu contraseña

# ==========================================
# JWT Configuration
# ==========================================
JWT_SECRET=your-secret-key-change-this-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# ==========================================
# CORS Configuration
# ==========================================
CORS_ORIGIN=http://localhost:3000

# ==========================================
# Frontend Configuration
# ==========================================
# URL del frontend (usado en emails de recuperación de contraseña)
FRONTEND_URL=http://localhost:3000

# ==========================================
# Email Configuration
# ==========================================

# Servicio de email a usar
# Opciones: 'gmail', 'sendgrid', 'smtp'
# Dejar vacío para modo desarrollo (solo muestra en consola)
EMAIL_SERVICE=

# Credenciales de email
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=Lotería App

# --------- OPCIÓN 1: Gmail ---------
# 1. Activa "Verificación en 2 pasos" en tu cuenta de Google
# 2. Ve a https://myaccount.google.com/apppasswords
# 3. Genera una "Contraseña de aplicación"
# 4. Usa esa contraseña (16 caracteres sin espacios) como EMAIL_PASSWORD
#
# EMAIL_SERVICE=gmail
# EMAIL_USER=tu-email@gmail.com
# EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# --------- OPCIÓN 2: SendGrid ---------
# 1. Crea cuenta en https://sendgrid.com
# 2. Ve a Settings -> API Keys
# 3. Crea un API Key
# 4. Usa el API Key como EMAIL_PASSWORD
#
# EMAIL_SERVICE=sendgrid
# EMAIL_USER=apikey
# EMAIL_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --------- OPCIÓN 3: SMTP Genérico ---------
# EMAIL_SERVICE=smtp
# EMAIL_USER=tu-email@dominio.com
# EMAIL_PASSWORD=tu-contraseña
# SMTP_HOST=smtp.tu-servidor.com
# SMTP_PORT=587
# SMTP_SECURE=false

# ==========================================
# Lottery Business Configuration
# ==========================================
MIN_TICKET_PRICE=10
MAX_TICKET_PRICE=1000
COMMISSION_PERCENTAGE=10
